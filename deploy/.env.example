# 운영 컨테이너 스택(docker-compose.prod.yml)이 읽는 환경변수 템플릿.
# 사용법:  cp deploy/.env.example deploy/.env  →  값 채우기
#          docker compose -f docker-compose.prod.yml --env-file deploy/.env up -d
# deploy/.env 는 커밋 금지(.gitignore). EC2에서는 /opt/finntech/.env (chmod 600)에 둔다.
# 로컬 개발용 .env(루트)와는 별개다 — 그쪽은 스크립트가 셸에 주입하는 용도다.

# ── DB ───────────────────────────────────────────────────────────
# 로컬 총연습: mysql 컨테이너를 쓰므로 DB_HOST=mysql (서비스명 DNS).
# EC2에서 RDS를 쓰면 여기에 RDS 엔드포인트를 넣고 --profile local-db 없이 기동한다.
DB_HOST=mysql
DB_PORT=3306
DB_NAME=finntech
MYDATA_DB_NAME=finntech_mydata
DB_USER=finntech
DB_PASSWORD=                     # [필수] 비면 두 백엔드가 기동 실패한다(fail-fast, W7-3)
MYSQL_ROOT_PASSWORD=             # [필수] mysql 컨테이너를 쓸 때만. RDS면 무시된다.

# ── 서버간 인증 (backend → backend-mydata /bank/**) ──────────────
# [필수] 비면 SharedSecretRequiredGuard가 기동을 막는다. 두 모듈에 같은 값이 들어간다.
MYDATA_SHARED_SECRET=

# ── 시각 기준 (§8-D) ─────────────────────────────────────────────
# 운영에서는 둘 다 비워 실시간으로 돈다. 발표 리허설로 날짜를 고정할 때만 두 값을
# 같은 날짜로 함께 넣는다 — 한쪽만 고정하면 데이터 공급과 판정의 시계가 어긋나 소비가 0건이 된다.
FINNTECH_DEMO_TODAY=
MYDATA_NOW=

# ── 선택 ─────────────────────────────────────────────────────────
GEMINI_API_KEY=                  # 비우면 고정 템플릿 문장으로 폴백(정상 동작). 가입자격 라벨링도 이 키를 쓴다.
GEMINI_MODEL=                    # 비우면 gemini-3.1-flash-lite. 모델이 은퇴하거나 할당량 0이 되면 배포 없이 여기서 갈아탄다.
FSS_API_KEY=                     # 금감원 공시 오픈API(32자리). 비우면 통장 비교가 조용히 더미로 간다.
TSA_ENABLED=false                # 외부 FreeTSA 앵커링. 네트워크가 막히면 기동이 느려진다.
