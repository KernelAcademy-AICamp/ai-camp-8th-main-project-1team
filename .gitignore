# ── 빌드 산출물 ──
backend/target/
backend-mydata/target/
frontend/dist/
frontend/node_modules/

# 토스 미니앱 — frontend 와 같은 규칙
frontend-toss/dist/
frontend-toss/node_modules/
frontend-toss/test-dist/
frontend-toss/demo-dist/
frontend-toss/demo-preview.html
frontend-toss/shots/
frontend-toss/*.ait
frontend-toss/.ait/
frontend-toss/tsconfig.tsbuildinfo

# ── 로컬 DB (H2 파일) ──
backend/data/
backend-mydata/data/
# 저장소 루트의 H2 파일 — 락 파일이 실행할 때마다 바뀌어 변경으로 잡힌다.
data/
*.mv.db
*.trace.db

# ── 내부 문서(업로드 제외, CLAUDE.md 규칙) ──
_archive/

# ── 파이썬/가상환경 ──
.venv/
__pycache__/
*.pyc

# ── OS/IDE ──
.DS_Store
.vscode/
.idea/
*.iml

# ── Claude Code 개인 로컬 설정 ──
.claude/settings.local.json

# ── 시크릿·환경변수 (W7-3) — .env는 커밋 금지, .env.example만 커밋 ──
.env
.env.*
!.env.example

# ── 참조 원본 데이터(대용량, 카탈로그 빌드 입력 — 코드 아님. GitHub 100MB 초과분 포함) ──
# reference/*.md 문서(launch_plan·mydata_catalog 등)는 커밋한다. 원본 CSV/XLSX/geo만 제외.
reference/*.csv
reference/*.xlsx
reference/*.xls
reference/*.html
reference/geo/
# 공공데이터 원본 묶음(심평원 병의원·약국 63MB, 목욕탕 shapefile). 상호 풀 빌드 입력이지
# 코드가 아니다 — scripts/ksic 가 이걸 읽어 카탈로그를 만들고, 산출물만 커밋한다.
reference/전국 병의원 및 약국 현황*/
reference/*공간정보/
# 국세청 업종코드는 예외로 커밋한다 — 755K로 작고, 대조표(scripts/industry/nts-mid.tsv)의
# **근거**이자 build_industry.py 가 매 빌드에서 "이 코드가 실재하는가"를 검증하는 입력이다.
# 없으면 빌드가 막히고, 대조표만 남으면 왜 그 중분류인지 확인할 길이 사라진다.
!reference/업종코드-국세청-2025.csv

# ── 타사 앱 바이너리·역분석 자료: 공개 저장소에 올리지 않는다 ──
# reference/*.md 는 위 정책상 커밋 대상이라, 여기서 이름으로 되돌려 빼야 한다.
# CJpost 분석보고서에는 타사 내부 IP·비공개 엔드포인트·라이선스 식별자·API 키가 인용돼 있고
# 문서 스스로 "외부 공유·게시하지 마십시오"라고 명시한다. APK는 타사 상용 앱 바이너리다.
reference/*.apk
reference/CJpost_기술구조_분석보고서.md

# ── 정리 CSV: 합본은 282MB(GitHub 100MB 초과)라 제외. 분할본(merchants-part*.csv, <50MB)만 커밋 ──
backend-mydata/generated/merchants.csv

# ── 로그·임시 ──
*.log

# 운영 이전용 DB 덤프(수 GB) — 커밋 금지
deploy/dump/

# ── 발표자료·발표자메모: 저장소 밖에 둔다 ──
# .key 는 바이너리라 diff 가 안 되고 **한 글자만 고쳐도 매 버전이 통째로 이력에 쌓인다**
# (중간데모 자료 하나가 6.1MB). 발표자료는 고치며 여러 번 저장하는 물건이라 클론이 계속 무거워진다.
# 저장소에 .key 선례도 없었다. 공유는 드라이브 등 저장소 밖에서 한다.
*.key
reference/기획/_history/*_발표자메모.md

# ── 카드 공시 원문(손으로 받은 PDF): 수집물은 git 밖 ──
# scripts/collect-cards/.gitignore 가 out/ 을 빼는 것과 **같은 원칙**이다. manual_pdf/ 는 그
# 폴더 밖에 있어서 딸려 들어갈 뿐 성격은 같은 수집 원문이고, 카드사 저작물이기도 하다.
# 원문 관리는 개인카드-로컬전용/ 한 곳으로 모은다(카드사별-수집경로.md 참조).
scripts/collect-cards/manual_pdf/
