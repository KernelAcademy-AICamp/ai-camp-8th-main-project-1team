# ── frontend-moa 환경변수 (프론트에는 시크릿을 절대 두지 않는다) ──
# 백엔드 API 주소. 기본값은 로컬 8080.
VITE_API_BASE=http://localhost:8080

# 데모용 사용자 id (마이데이터 시드 사용자)
VITE_DEMO_USER_ID=1

# 본인인증 모드: "virtual" = 내부 테스트(가상 인증 버튼 1회) / "sms" = 외부 시연(입력필드+실 SMS)
# 실제 SMS는 백엔드가 Solapi로 발송한다. 프론트는 엔드포인트만 호출한다.
VITE_AUTH_MODE=virtual

# ⚠️ SOLAPI(coolsms) API KEY·SECRET 은 여기에 두지 않는다.
#   → 백엔드(backend/)의 .env / application-local.yml(둘 다 gitignore)에만,
#     SOLAPI_API_KEY / SOLAPI_API_SECRET 로 두고 프론트로는 절대 내려보내지 않는다.
