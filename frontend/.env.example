# 프론트(Vite) 환경변수 템플릿. Vite는 frontend/.env* 를 자동 로드한다.
# 사용법:  cp frontend/.env.example frontend/.env.local  →  값 확인. (.env.local 은 커밋 금지)
#
# ⚠️ VITE_* 는 전부 **빌드 산출물에 그대로 박힌다**(공개된다). 시크릿을 넣지 않는다.

# ── 웹(개발·데모) ────────────────────────────────────────────────
# 브라우저 → 백엔드 주소. mysql 풀스택은 backend가 8090(구버전 H2 데모는 8080).
VITE_API_BASE=http://localhost:8090

# (선택) 데모 자동 로그인용 생성 사용자 CI. 비우면 온보딩에서 수동 진행.
# 데이터 재생성 시 값이 바뀌므로 demo-e2e.sh 가 뽑아주는 값으로 갱신.
# 이 값이 있으면 '마이 > 데모 패널'과 온보딩의 '개발용 건너뛰기'가 노출된다.
VITE_DEMO_CI=

# ── 앱(Capacitor) 빌드 시 ────────────────────────────────────────
# 웹 자산이 기기 안에서 실행되므로 localhost 는 **기기 자신**을 가리킨다.
# 개발 PC의 백엔드에 닿지 않으므로 반드시 실제 도메인을 넣는다.
#
#   VITE_API_BASE=https://api.<배포도메인>
#
# HTTPS 여야 하는 이유 — 안드로이드는 API 28+ 부터 평문 HTTP 를 기본 차단한다
# (cleartext traffic). http:// 를 쓰려면 network_security_config 예외를 열어야 하는데,
# 실기기 시연에서 그 예외를 켜 두는 것은 권하지 않는다.
#
# 그리고 앱 배포 빌드에서는 VITE_DEMO_CI 를 반드시 비운다 — 채워 두면 데모 패널과
# 인증 건너뛰기가 실사용 화면에 그대로 노출된다.
#
# 백엔드 쪽 짝 설정: CORS_ALLOWED_ORIGINS 에 앱 origin(capacitor://localhost 등)을
# 넣어야 한다. 루트 .env.example 참조.
