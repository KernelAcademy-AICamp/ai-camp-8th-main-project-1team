# 백엔드(backend·backend-mydata, mysql 프로파일) 환경변수 템플릿.
# 사용법:  cp .env.example .env  →  값 채우기  →  scripts/gen-mydata.sh / scripts/run-stack-mysql.sh 가 자동 source.
# 주의: Spring Boot는 .env를 자동 로드하지 않는다(스크립트가 `set -a; source .env; set +a`로 주입). .env는 커밋 금지(.gitignore).
# 프론트(VITE_*)는 frontend/.env.example 참조 — Vite가 frontend/.env* 를 별도로 자동 로드한다.

# ── DB (mysql 프로파일) ──────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=finntech                 # 백엔드 앱 DB
MYDATA_DB_NAME=finntech_mydata   # 마이데이터 제공자 DB(생성 데이터 적재처)
DB_USER=finntech
DB_PASSWORD=                     # [필수] 미설정 시 mysql 프로파일 기동 실패(fail-fast). 로컬 예: finntech

# ── 서버간 인증 (backend ↔ backend-mydata /bank/**) ──────────────
# [필수] mysql 프로파일에서 비어 있으면 SharedSecretRequiredGuard가 기동을 막는다. 두 모듈에 동일 값 주입.
MYDATA_SHARED_SECRET=            # 예(데모): demo-mydata-shared-2026
MYDATA_BASE_URL=http://localhost:8082

# ── LLM (선택) ───────────────────────────────────────────────────
# 비우면 NarrativeService가 템플릿 폴백(정상 동작). 실 문장 생성하려면 Gemini 키 입력.
# 가입자격 라벨링(EligibilityLabelService)도 이 키를 쓴다 — 없으면 규칙 파서로 판정한다.
GEMINI_API_KEY=
GEMINI_MODEL=                    # 비우면 gemini-3.1-flash-lite

# ── 통장 비교 (선택) ─────────────────────────────────────────────
# 금감원 금융상품통합비교공시 오픈API 인증키(32자리). https://finlife.fss.or.kr 에서 발급.
# **비우면 외부를 아예 때리지 않고 더미 목록을 보여준다.** 화면은 정상 동작하지만 표시되는
# 금리가 실제 값이 아니므로, 실 금리를 보여주려면 반드시 채워야 한다.
FSS_API_KEY=

# ── CORS / 기타 (선택, 기본값 있음) ──────────────────────────────
# 뒤 3개는 앱(Capacitor) 웹뷰 오리진. 웹 자산이 기기 안에서 서빙돼 오리진이 도메인이 아니고,
# 플랫폼·설정에 따라 셋 중 하나가 된다(안드로이드 http/https, iOS capacitor).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,capacitor://localhost,https://localhost,http://localhost
TSA_ENABLED=false                # 외부 TSA 앵커링(계층3). 기본 off.
FINNTECH_DEV_SEED_ENABLED=true   # dev 시드 경로 허용(데모)
# 운영 관측(/api/ops/health) — 침묵률·폴백률·모델 임계. 개인정보 없음, 기본 켜짐.
# 끄려면 false. nginx 는 /api/ 아래를 경로별 구분 없이 넘기므로 통제는 이 스위치가 한다.
FINNTECH_OPS_ENABLED=true
# 실제 사람 1명의 카드내역 입력(마이데이터 제공자 /admin/realdata). **실 개인정보 + 파기.**
# 기본 꺼짐 — 넣을 때만 켠다. 넣은 데이터는 덤프에 실려 AWS·운영 MySQL 로 간다.
MYDATA_REALDATA_ENABLED=false

# ── 참고: 코드가 참조하지 않는 값은 넣지 않는다 ──────────────────
# SOLAPI(SMS) 키는 현재 코드에서 사용하지 않음(인증은 가상 CI 스텁) → 여기 두지 않는다.
# (FSS 키는 2026-07-24 통장 비교가 금감원 API로 전환하면서 실제로 쓰기 시작했다 — 위에 있다.)
